{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "allowJs": true,
    "checkJs": false,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": false,

    "noEmit": true
  },

  "include": [
    "aether/**/*.ts",
    "foundation/**/*.ts",
    "runtime/**/*.ts",
    "capabilities/**/*.ts",
    "scene/**/*.ts",
    "math/**/*.ts",
    "models/**/*.ts",
    "geometry/**/*.ts",
    "libraries/**/*.ts",
    "validation/**/*.ts",
    "interfaces/**/*.ts",
    "integrity/**/*.ts",
    "*.ts",
    "engine.js"
  ]
}
